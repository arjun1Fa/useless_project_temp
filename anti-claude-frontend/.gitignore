# ==========================================
# ANTI-CLAUDE REPOSITORY .gitignore
# ==========================================

# Dependencies (7000+ files)
node_modules/
*/node_modules/
*/*/node_modules/
.pnpm-store/

# Production & Build Outputs
dist/
*/dist/
*/*/dist/
build/
*/build/
out/
.next/
.turbo/
*.tsbuildinfo
.vite/
*/.vite/

# Environment variables & API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test & Coverage Outputs
coverage/
.nyc_output/
*.lcov

# Temporary files & Caches
.cache/
.temp/
.tmp/
tmp/
temp/
scratch/
*.swp
*~

# Agent Skills (Design with Intent & Expo Skills)
.agents/
.claude/
agent/
skills/
**/skills/

