# ─── Application ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Get this from: Supabase → Project Settings → Database → Connection String (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Grok API Keys (xAI) ─────────────────────────────────────────────────────
# Add as many keys as needed. Client tries key 1 first, falls back to key 2, etc.
GROK_API_KEY_1="xai-your-key-here"
GROK_API_KEY_2="xai-your-key-here"
# GROK_API_KEY_3="xai-your-key-here"

# Grok model to use (default: grok-3-fast)
GROK_MODEL="grok-3-fast"
GROK_MAX_TOKENS=2048
GROK_TIMEOUT_MS=30000

# ─── Storage (local disk fallback) ───────────────────────────────────────────
# Set STORAGE_TYPE=local for hackathon. Set STORAGE_TYPE=s3 to use S3-compatible.
STORAGE_TYPE=local
STORAGE_LOCAL_DIR="./uploads"

# S3-compatible (only needed if STORAGE_TYPE=s3)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="anti-claude-attachments"

# ─── Cors ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
